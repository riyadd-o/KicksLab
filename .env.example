# ==========================================
# KicksLab - Environment Variables Example
# ==========================================
# Copy this file to .env or .env.local and fill in your actual values.
# NEVER commit your real .env or .env.local to version control!

# ── Database (PostgreSQL) ─────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/kickslab?schema=public"

# ── Authentication (NextAuth / Auth.js / Jose) ─
# Generate with: openssl rand -base64 32
AUTH_SECRET="your_auth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# ── Chapa Payment Gateway ─────────────────
# Get keys from Chapa Dashboard (https://dashboard.chapa.co/)
CHAPA_SECRET_KEY="CHASECK_TEST-your_chapa_secret_key_here"

# ── Email Service (Gmail SMTP / Nodemailer) ──
# For Gmail, use an App Password (not your personal account password)
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_gmail_app_password_here"

# ── Admin & Seeding Configuration ─────────
ADMIN_EMAIL="admin@kickslab.com"

# ── Cloudinary (Product Media Uploads) ────
# Required if uploading images via Admin panel
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
