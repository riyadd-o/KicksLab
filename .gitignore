# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js build and production outputs
/.next/
/out/
/build
/dist

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# keep example env file tracked
!.env.example

# debug and logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript & cache files
*.tsbuildinfo
next-env.d.ts

# prisma generated artifacts
/lib/generated/prisma

# local development & scratch utilities
/scratch/
/test-db.js
/fix_text_colors.js

# OS & certificate files
.DS_Store
Thumbs.db
*.pem
